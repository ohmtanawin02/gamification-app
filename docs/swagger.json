                    "type": "integer",
                    "minimum": 1
                }
            }
        },
        "dto.LoginRequest": {
            "type": "object",
            "required": [
                "nickname"
            ],
            "properties": {
                "nickname": {
                    "type": "string",
                    "maxLength": 100,
                    "minLength": 1
                }
            }
        },
        "dto.SpinRequest": {
            "type": "object",
            "required": [
                "points_earned"
            ],
            "properties": {
                "points_earned": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        }
